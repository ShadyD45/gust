# Binaries
/gust
/gust.exe
*.exe

# Demo and example outputs
/demo/out/*
!/demo/out/.gitkeep
/out/
gust-report.html

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Go
coverage.out
*.test

# Python SDK
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# TypeScript SDK build output is committed under lib/ (package entrypoint).
# Keep ignoring accidental caches and tsc side-products.
sdk/typescript/node_modules/
sdk/typescript/.pytest_cache/
sdk/typescript/pytest-cache-files-*/
sdk/typescript/**/*.map
sdk/typescript/**/*.tsbuildinfo
sdk/typescript/lib/**/*.test.d.ts
