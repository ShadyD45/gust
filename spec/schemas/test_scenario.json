{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.dev/schemas/test_scenario.json",
  "title": "TestScenario",
  "description": "Autonomous software test scenario artifact",
  "type": "object",
  "required": [
    "id",
    "version",
    "description",
    "task",
    "environment",
    "assertions",
    "reliability",
    "provenance"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "task": {
      "type": "object",
      "required": ["input"],
      "properties": {
        "id": { "type": "string" },
        "input": { "type": "string", "minLength": 1 },
        "context": { "type": "object" }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "properties": {
        "fixture_strategy": {
          "type": "string",
          "enum": ["exact_hash", "ordered_sequence", "prefer_exact_then_sequence"]
        },
        "fixtures": {
          "type": "array",
          "items": { "$ref": "fixture.json" }
        },
        "fixtures_dir": {
          "type": "string",
          "description": "Directory of fixture JSON files, relative to the scenario file"
        }
      },
      "additionalProperties": false
    },
    "assertion_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "YAML/JSON files that contain an array of assertions, relative to the scenario file"
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$ref": { "type": "string" },
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "task_success",
              "tool_call",
              "forbidden_tool_call",
              "required_tool",
              "tool_sequence",
              "max_steps",
              "max_latency_ms",
              "schema_valid",
              "error_recovery"
            ]
          },
          "criticality": {
            "type": "string",
            "enum": ["hard", "soft"]
          },
          "tool": { "type": "string" },
          "arguments": { "type": "object" },
          "limit": { "type": "integer" },
          "parameters": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "reliability": {
      "type": "object",
      "properties": {
        "samples": { "type": "integer", "minimum": 1 },
        "minimum_pass_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "deterministic": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source", "extracted_at"],
      "properties": {
        "source": { "type": "string" },
        "source_run_id": { "type": "string" },
        "extracted_at": { "type": "string", "format": "date-time" },
        "reviewed_by": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "description": "Optional end-user Mode 3 hook. CLI flags override these fields.",
      "properties": {
        "type": { "type": "string", "enum": ["http", "exec"] },
        "url": { "type": "string" },
        "command": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "traces": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": ["auto", "response", "file", "otel", "otel-file"]
            },
            "path": { "type": "string" },
            "wait_timeout_seconds": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
