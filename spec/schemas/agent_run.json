{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.dev/schemas/agent_run.json",
  "title": "AgentRun",
  "description": "Captured execution trace of an agent run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "agent",
    "task",
    "trace",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["0.5"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "git_commit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "input"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "input": { "type": "string", "minLength": 1 },
        "context": { "type": "object" }
      },
      "additionalProperties": true
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["span_id", "name", "type", "start_time", "end_time", "status"],
        "properties": {
          "span_id": { "type": "string", "minLength": 1 },
          "parent_span_id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["agent", "llm", "tool", "retrieval", "memory", "plan", "error"]
          },
          "start_time": { "type": "string", "format": "date-time" },
          "end_time": { "type": "string", "format": "date-time" },
          "attributes": { "type": "object" },
          "status": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": { "type": "string", "enum": ["ok", "error"] },
              "message": { "type": "string" }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "failed", "timeout", "cancelled"]
        },
        "output": { "type": "string" },
        "error": { "type": "string" },
        "duration_ns": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
