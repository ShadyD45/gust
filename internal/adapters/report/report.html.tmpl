{{define "report"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gust reliability report</title>
<style>
:root {
  --bg: #f4f6f8;
  --surface: #ffffff;
  --ink: #1a1f24;
  --muted: #5c6770;
  --line: #d8dee4;
  --pass: #0f7a3a;
  --pass-bg: #e7f6ec;
  --fail: #b42318;
  --fail-bg: #fdeceb;
  --warn: #9a6700;
  --warn-bg: #fff6e0;
  --info: #334155;
  --info-bg: #eef2f6;
  --accent: #1f4b73;
  --shadow: 0 1px 2px rgba(16, 24, 40, .06), 0 8px 24px rgba(16, 24, 40, .04);
  --radius: 12px;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --sans: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  color: var(--ink);
  background:
    radial-gradient(1200px 500px at 10% -10%, #e8eef5 0%, transparent 55%),
    var(--bg);
  font: 15px/1.45 var(--sans);
}
a { color: var(--accent); }
.wrap { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
header.hero {
  display: flex; gap: 1rem; align-items: flex-start; justify-content: space-between;
  flex-wrap: wrap; margin-bottom: 1.25rem;
}
h1 { margin: 0 0 .35rem; font-size: 1.65rem; letter-spacing: -.02em; }
.meta { color: var(--muted); font-size: .92rem; }
.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 1rem 1.15rem;
  margin: 1rem 0;
}
.card h2 { margin: 0 0 .65rem; font-size: 1.15rem; display: flex; gap: .55rem; align-items: center; flex-wrap: wrap; }
.card h3 { margin: 1rem 0 .5rem; font-size: 1rem; }
.row { display: flex; gap: .75rem; flex-wrap: wrap; align-items: center; }
.icon {
  width: 1.55rem; height: 1.55rem; border-radius: 999px;
  display: inline-grid; place-items: center; font-weight: 700; font-size: .95rem;
  flex: 0 0 auto;
}
.icon.pass { color: var(--pass); background: var(--pass-bg); }
.icon.fail { color: var(--fail); background: var(--fail-bg); }
.icon.warn { color: var(--warn); background: var(--warn-bg); }
.icon.info { color: var(--info); background: var(--info-bg); }
.badge {
  display: inline-flex; align-items: center; gap: .3rem;
  padding: .18rem .55rem; border-radius: 999px; font-size: .78rem; font-weight: 600;
  border: 1px solid transparent;
}
.badge.pass { color: var(--pass); background: var(--pass-bg); border-color: #b7e0c4; }
.badge.fail { color: var(--fail); background: var(--fail-bg); border-color: #f0b4ae; }
.badge.warn { color: var(--warn); background: var(--warn-bg); border-color: #efd39a; }
.badge.info { color: var(--info); background: var(--info-bg); border-color: #c9d4e0; }
.stat-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: .65rem; margin: .75rem 0 1rem;
}
.stat {
  background: #f8fafc; border: 1px solid var(--line); border-radius: 10px; padding: .65rem .75rem;
}
.stat .label { color: var(--muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; }
.stat .value { font-size: 1.15rem; font-weight: 700; margin-top: .15rem; font-variant-numeric: tabular-nums; }
.bar {
  display: flex; height: 10px; border-radius: 999px; overflow: hidden; background: #e8edf2; margin: .35rem 0 .85rem;
}
.bar > span { display: block; height: 100%; }
.bar .pass { background: var(--pass); }
.bar .fail { background: var(--fail); }
.bar .infra { background: #64748b; }
.toolbar {
  display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; justify-content: space-between;
  margin: .35rem 0 .85rem;
}
.filters, .actions { display: flex; gap: .4rem; flex-wrap: wrap; }
.chip, button.chip {
  appearance: none; border: 1px solid var(--line); background: #fff; color: var(--ink);
  border-radius: 999px; padding: .35rem .7rem; font: inherit; font-size: .85rem; cursor: pointer;
}
.chip:hover { border-color: #9aa8b5; }
.chip.active { background: var(--accent); border-color: var(--accent); color: #fff; }
.chip .count {
  display: inline-block; min-width: 1.2rem; text-align: center; margin-left: .2rem;
  opacity: .85; font-variant-numeric: tabular-nums;
}
details.sample {
  border: 1px solid var(--line); border-radius: 10px; background: #fff; margin: .45rem 0; overflow: hidden;
}
details.sample[open] { box-shadow: var(--shadow); }
details.sample > summary {
  list-style: none; cursor: pointer; padding: .7rem .85rem;
  display: flex; gap: .65rem; align-items: flex-start; justify-content: space-between;
}
details.sample > summary::-webkit-details-marker { display: none; }
details.sample > summary .left { display: flex; gap: .65rem; align-items: flex-start; min-width: 0; }
details.sample > summary .ids { min-width: 0; }
details.sample > summary .ids .id {
  font-family: var(--mono); font-size: .82rem; word-break: break-all;
}
details.sample .body { padding: 0 .85rem .85rem; border-top: 1px solid var(--line); }
.hidden { display: none !important; }
table { border-collapse: collapse; width: 100%; margin-top: .65rem; }
th, td { border: 1px solid var(--line); padding: .45rem .55rem; text-align: left; vertical-align: top; font-size: .88rem; }
th { background: #f1f5f9; font-weight: 600; }
td.mark { width: 2.4rem; text-align: center; font-weight: 700; }
td.mark.pass { color: var(--pass); background: var(--pass-bg); }
td.mark.fail { color: var(--fail); background: var(--fail-bg); }
pre {
  margin: 0; white-space: pre-wrap; word-break: break-word;
  background: #f6f8fa; padding: .55rem .65rem; border-radius: 6px;
  font: .8rem/1.35 var(--mono); max-height: 14rem; overflow: auto;
}
.violations { margin: .5rem 0 0; padding-left: 1.1rem; }
.violations li { margin: .25rem 0; }
.empty { color: var(--muted); font-style: italic; padding: .35rem 0; }
.corr { color: var(--muted); font-size: .82rem; font-family: var(--mono); }
.section-label { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
@media (max-width: 640px) {
  .wrap { padding: 1rem .85rem 2rem; }
  details.sample > summary { flex-direction: column; }
}
</style>
</head>
<body>
<div class="wrap">
  <header class="hero">
    <div>
      <h1>Gust reliability report</h1>
      <p class="meta">
        generated {{.GeneratedAt}}
        {{if .EvaluationID}} · evaluation <code>{{.EvaluationID}}</code>{{end}}
        {{if .PolicyName}} · policy <code>{{.PolicyName}}</code>{{end}}
      </p>
    </div>
    <div class="badge {{.Overall.Class}}" title="Overall verdict">
      <span class="icon {{.Overall.Class}}" aria-hidden="true">{{.Overall.Icon}}</span>
      {{.Overall.Verdict}}
    </div>
  </header>

  <section class="card" id="overall">
    <h2>
      <span class="icon {{.Overall.Class}}" aria-hidden="true">{{.Overall.Icon}}</span>
      Overall: {{.Overall.Verdict}}
    </h2>
    <p class="meta">Exit code {{.Overall.ExitCode}}{{if ne .Overall.ExitCode 0}} — see violations below{{end}}</p>
    {{if .Overall.Violations}}
    <ul class="violations">
      {{range .Overall.Violations}}<li>{{.}}</li>{{end}}
    </ul>
    {{end}}
    <div class="stat-grid">
      <div class="stat"><div class="label">Scenarios</div><div class="value">{{len .Scenarios}}</div></div>
      <div class="stat"><div class="label">Passed</div><div class="value">{{.Totals.Pass}}</div></div>
      <div class="stat"><div class="label">Failed</div><div class="value">{{.Totals.Fail}}</div></div>
      <div class="stat"><div class="label">Infrastructure</div><div class="value">{{.Totals.Infra}}</div></div>
    </div>
  </section>

  {{range $si, $sc := .Scenarios}}
  <section class="card scenario" data-scenario="{{$sc.ID}}">
    <h2>
      <span class="icon {{$sc.Class}}" aria-hidden="true">{{$sc.Icon}}</span>
      <span>{{$sc.ID}}</span>
      <span class="badge {{$sc.Class}}">{{$sc.Verdict}}</span>
      {{if $sc.HardConstraintFailed}}<span class="badge fail">hard constraints</span>{{end}}
    </h2>

    <div class="bar" title="Sample mix" aria-hidden="true">
      {{if gt $sc.PassCount 0}}<span class="pass" style="width:{{$sc.PassPct}}%"></span>{{end}}
      {{if gt $sc.FailCount 0}}<span class="fail" style="width:{{$sc.FailPct}}%"></span>{{end}}
      {{if gt $sc.InfraCount 0}}<span class="infra" style="width:{{$sc.InfraPct}}%"></span>{{end}}
    </div>

    <div class="stat-grid">
      <div class="stat"><div class="label">Requested</div><div class="value">{{$sc.Requested}}</div></div>
      <div class="stat"><div class="label">Completed</div><div class="value">{{$sc.Completed}}</div></div>
      <div class="stat"><div class="label">Passes</div><div class="value">{{$sc.Passes}}</div></div>
      <div class="stat"><div class="label">Behavioral fails</div><div class="value">{{$sc.BehavioralFailures}}</div></div>
      <div class="stat"><div class="label">Infra errors</div><div class="value">{{$sc.InfraErrors}}</div></div>
      <div class="stat"><div class="label">Observed</div><div class="value">{{$sc.Observed}}</div></div>
      <div class="stat"><div class="label">Wilson 95% CI</div><div class="value">[{{$sc.CILow}}, {{$sc.CIHigh}}]</div></div>
    </div>

    <div class="toolbar">
      <div class="filters" role="group" aria-label="Filter samples">
        <button type="button" class="chip active" data-filter="all">All<span class="count">{{len $sc.Samples}}</span></button>
        <button type="button" class="chip" data-filter="fail">Failed<span class="count">{{$sc.FailCount}}</span></button>
        <button type="button" class="chip" data-filter="pass">Passed<span class="count">{{$sc.PassCount}}</span></button>
        <button type="button" class="chip" data-filter="infra">Infra<span class="count">{{$sc.InfraCount}}</span></button>
      </div>
      <div class="actions">
        <button type="button" class="chip" data-action="expand">Expand visible</button>
        <button type="button" class="chip" data-action="collapse">Collapse</button>
        <button type="button" class="chip" data-action="assertions-failed">Failed asserts only</button>
        <button type="button" class="chip" data-action="assertions-all">All asserts</button>
      </div>
    </div>

    {{if not $sc.Samples}}
      <p class="empty">No per-sample details recorded.</p>
    {{else}}
      {{range $sc.Samples}}
      <details class="sample" data-kind="{{.Kind}}" {{if .Open}}open{{end}}>
        <summary>
          <div class="left">
            <span class="icon {{.Class}}" aria-hidden="true">{{.Icon}}</span>
            <div class="ids">
              <div class="id">{{.SampleID}}</div>
              <div class="meta">{{.StatusLabel}}{{if .Category}} · {{.Category}}{{end}} · asserts ✓{{.PassAssert}} ✗{{.FailAssert}}</div>
            </div>
          </div>
          <span class="badge {{.Class}}">{{.KindLabel}}</span>
        </summary>
        <div class="body">
          {{if .Message}}<p>{{.Message}}</p>{{end}}
          {{if or .RunID .TraceID}}
          <p class="corr">
            {{if .RunID}}run {{.RunID}}{{end}}
            {{if and .RunID .TraceID}} · {{end}}
            {{if .TraceID}}trace {{.TraceID}}{{end}}
          </p>
          {{end}}

          {{if .Evaluations}}
          <div class="section-label"><h3>Assertions</h3></div>
          <table>
            <thead><tr><th></th><th>Assertion</th><th>Criticality</th><th>Message</th><th>Evidence</th></tr></thead>
            <tbody>
            {{range .Evaluations}}
              <tr class="assert-row" data-passed="{{if .Passed}}true{{else}}false{{end}}">
                <td class="mark {{.Class}}">{{.Icon}}</td>
                <td>{{.Name}}</td>
                <td>{{if .Criticality}}{{.Criticality}}{{else}}—{{end}}</td>
                <td>{{.Message}}</td>
                <td>{{if .Evidence}}<pre>{{.Evidence}}</pre>{{else}}—{{end}}</td>
              </tr>
            {{end}}
            </tbody>
          </table>
          {{end}}

          {{if .FixtureCalls}}
          <details>
            <summary class="meta" style="cursor:pointer;padding:.35rem 0">Fixture calls ({{len .FixtureCalls}})</summary>
            <table>
              <thead><tr><th>Tool</th><th>Fixture</th><th>Mode</th><th>Status</th><th>Body</th></tr></thead>
              <tbody>
              {{range .FixtureCalls}}
                <tr>
                  <td>{{.Tool}}</td>
                  <td>{{.FixtureID}}</td>
                  <td>{{.Mode}}</td>
                  <td>{{.Status}}</td>
                  <td>{{if .Body}}<pre>{{.Body}}</pre>{{else}}{{if .Error}}<pre>{{.Error}}</pre>{{else}}—{{end}}{{end}}</td>
                </tr>
              {{end}}
              </tbody>
            </table>
          </details>
          {{end}}
        </div>
      </details>
      {{end}}
    {{end}}
  </section>
  {{end}}
</div>
<script>
(function () {
  function setFilter(scenario, kind) {
    scenario.querySelectorAll(".filters .chip").forEach(function (btn) {
      btn.classList.toggle("active", btn.getAttribute("data-filter") === kind);
    });
    scenario.querySelectorAll("details.sample").forEach(function (el) {
      var match = kind === "all" || el.getAttribute("data-kind") === kind;
      el.classList.toggle("hidden", !match);
    });
  }

  function setAssertionMode(scenario, failedOnly) {
    scenario.querySelectorAll(".assert-row").forEach(function (row) {
      var passed = row.getAttribute("data-passed") === "true";
      row.classList.toggle("hidden", failedOnly && passed);
    });
  }

  document.querySelectorAll(".scenario").forEach(function (scenario) {
    scenario.addEventListener("click", function (ev) {
      var t = ev.target.closest("[data-filter], [data-action]");
      if (!t || !scenario.contains(t)) return;
      if (t.hasAttribute("data-filter")) {
        setFilter(scenario, t.getAttribute("data-filter"));
        return;
      }
      var action = t.getAttribute("data-action");
      if (action === "expand") {
        scenario.querySelectorAll("details.sample:not(.hidden)").forEach(function (d) { d.open = true; });
      } else if (action === "collapse") {
        scenario.querySelectorAll("details.sample").forEach(function (d) { d.open = false; });
      } else if (action === "assertions-failed") {
        setAssertionMode(scenario, true);
      } else if (action === "assertions-all") {
        setAssertionMode(scenario, false);
      }
    });
    // Default: hide passed assertions until requested, keep failed visible.
    setAssertionMode(scenario, true);
  });
})();
</script>
</body>
</html>{{end}}
