{
  "name": "gust-sdk",
  "version": "0.5.0",
  "description": "Capture agent runs for gust, the test infrastructure for autonomous software",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test lib/recorder.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "keywords": [
    "llm",
    "agents",
    "testing",
    "evaluation",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ShadyD45/gust.git",
    "directory": "sdk/typescript"
  }
}
